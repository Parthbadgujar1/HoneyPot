# SentinelTrap environment configuration
# Copy to .env and fill in real values. NEVER commit secrets.

# --- Security ---
# MUST be changed in production. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_dev_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ALGORITHM=HS256

# --- Database ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_2026@localhost:5432/sentineltrap

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Honeypot ---
# local_simulated (default, safe in-process demo) | cowrie (read live Cowrie JSONL)
HONEYPOT_ADAPTER=local_simulated
HONEYPOT_COWRIE_LOG_PATH=honeypot/cowrie/logs
HONEYPOT_COWRIE_JSONL=honeypot/cowrie/logs/cowrie.json
HONEYPOT_POLL_INTERVAL=5

# --- ML ---
ML_MODELS_DIR=ml/models
ML_FEATURES_DIR=ml/features
ML_DATA_DIR=ml/data
ACTIVE_CLASSIFIER=random_forest
ACTIVE_ANOMALY=isolation_forest
ACTIVE_SEQUENCE=markov

# --- Risk engine (configurable weights, not claimed optimal) ---
RISK_WEIGHTS=anomaly:0.30,behaviour:0.25,sequence:0.15,resource:0.15,persistence:0.15
